{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/server.ts",
    "src/app.ts",
    "src/config/**/*.ts",
    "src/routes/**/*.ts",
    "src/middlewares/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/app/**"
  ]
}
