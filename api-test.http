@baseUrl = http://localhost:5000

### Add New Book
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "The Alchemist",
  "author": "Paulo Coelho",
  "category": "Fiction",
  "image": "https://images.unsplash.com/photo-1544947950-fa07a98d237f",
  "description": "A young shepherd travels in search of his personal legend.",
  "totalCopies": 10,
  "addedBy": {
    "name": "Samrat",
    "email": "samrat@example.com"
  }
}

@bookId = 6aeabc1104030cdd1565f6af

### Get Single Book
GET {{baseUrl}}/books/{{bookId}}

### Borrow a Book
POST {{baseUrl}}/borrows
Content-Type: application/json

{
  "bookId": "{{bookId}}",
  "userName": "Samrat",
  "userEmail": "samrat@example.com",
  "borrowDate": "2026-11-04",
  "returnDate": "2026-11-14"
}

### Get All Borrows
GET {{baseUrl}}/borrows

@bookId = 6aeabc1104030cdd1565f6af

### Borrow a Book
POST {{baseUrl}}/borrows
Content-Type: application/json

{
  "bookId": "{{bookId}}",
  "userName": "Samrat",
  "userEmail": "samrat@example.com",
  "borrowDate": "2026-11-04",
  "returnDate": "2026-11-14"
}

### Check Available Copies
GET {{baseUrl}}/books/{{bookId}}

### Get All Borrows
GET {{baseUrl}}/borrows

### Duplicate Borrow Test
POST {{baseUrl}}/borrows
Content-Type: application/json

{
  "bookId": "6aeabc1104030cdd1565f6af",
  "userName": "Samrat",
  "userEmail": "samrat@example.com",
  "borrowDate": "2026-11-04",
  "returnDate": "2026-11-14"
}

### Return Book
DELETE {{baseUrl}}/borrows/6aeabca004030cdd1565f6b0

### Check Book Copies
GET {{baseUrl}}/books/6aeabc1104030cdd1565f6af


